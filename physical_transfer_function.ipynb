import logging
import warnings
from typing import List

import matplotlib
import matplotlib.pyplot as plt
import numpy as np
from scipy import signal
from scipy.fft import rfft, irfft, rfftfreq
from scipy.stats import pearsonr
from sklearn.linear_model import Ridge

warnings.filterwarnings("ignore")
logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")


# ============================================================
# 1. Configuration
# ============================================================
CONFIG = {
    "SAMPLING_RATE": 200,
    "SAMPLES_PER_SEGMENT": 2000,
    "CROP_SIZE": 100,

    # Physics model
    "D_BASE": 1.08e3,
    "WEIGHT_REF": 65.0,
    "SPEAKER_WEIGHT_KG": 20.0,
    "HUMAN_WEIGHT_KG": 58.1,
    "TIKHONOV_LAMBDA": 0.1,

    # N-block / Volterra
    "N_BLOCK_MEMORY": 11,
    "N_BLOCK_ALPHA": 0.1,
    "PEAK_WEIGHT_ALPHA": 2.5,

    # Test samples to display at the end.
    # Use normal 1-based numbering and include both endpoints.
    # Example: 1 to 5 means show test samples #1, #2, #3, #4, #5.
    "VISUALIZE_START": 1,
    "VISUALIZE_END": 5,
}


# ============================================================
# 2. Physics model
# ============================================================
class PhysicsEngine:
    @staticmethod
    def get_transfer_function(freqs, D, weight_kg=65.0, is_human=True):
        omega = 2 * np.pi * freqs
        L, W, rho_h = 2.0, 1.0, 24.0
        xs, ys = 0.62, 0.5
        wr = weight_kg / CONFIG["WEIGHT_REF"]
        rc = (0.22 if is_human else 0.05) * (wr ** 0.33)
        gp = np.zeros_like(omega, dtype=complex)

        for nx in range(1, 10):
            for ny in [1, 3, 5]:
                p = np.sin(nx * np.pi * xs / L) * np.sin(ny * np.pi * ys / W)
                lam = (nx * np.pi / L) ** 2 + (ny * np.pi / W) ** 2
                mr = rho_h * L * W / 4 * (1 + 0.2 * wr)
                de = D * (1 + 0.0015 * freqs) * lam**2 * L * W / 4
                z = 0.94 * np.exp(-0.008 * freqs) if is_human else 0.40
                c = 2 * z * np.sqrt(mr * de)
                g = p * np.exp(-lam * rc**2 / 4)
                gp += p * g / (de - omega**2 * mr + 1j * omega * c + 1e-5)

        return gp


# ============================================================
# 3. Nonlinear N-block
# ============================================================
class VolterraNBlock:
    BASIC = ["x", "x^2", "|x|", "sign(x)*sqrt(|x|)"]

    @staticmethod
    def _basis(x):
        return np.column_stack([
            x,
            x**2,
            np.abs(x),
            np.sign(x) * np.sqrt(np.abs(x) + 1e-12),
        ])

    @staticmethod
    def expand(v, M):
        L = len(v)
        if L <= M:
            return np.zeros((1, 4 * (M + 1)))

        psi = VolterraNBlock._basis(v)
        P = np.zeros((L - M, 4 * (M + 1)))

        for lag in range(M + 1):
            P[:, 4 * lag:4 * (lag + 1)] = psi[M - lag:L - lag, :]

        return P

    @staticmethod
    def train(Xs, Ys, M=None, ra=None, pa=None):
        if M is None:
            M = CONFIG["N_BLOCK_MEMORY"] - 1
        if ra is None:
            ra = CONFIG["N_BLOCK_ALPHA"]
        if pa is None:
            pa = CONFIG["PEAK_WEIGHT_ALPHA"]

        if len(Xs) == 0 or len(Ys) == 0:
            raise ValueError("N-block training data are empty.")

        av = np.concatenate(Xs)
        ay = np.concatenate(Ys)

        vm, vs = float(np.mean(av)), float(np.std(av))
        ym, ys = float(np.mean(ay)), float(np.std(ay))

        if vs < 1e-9:
            vs = 1.0
        if ys < 1e-9:
            ys = 1.0

        Pl, Yl, Wl = [], [], []

        for i in range(len(Xs)):
            vn = (Xs[i] - vm) / vs
            yn = (Ys[i] - ym) / ys

            if len(vn) <= M:
                continue

            P = VolterraNBlock.expand(vn, M)
            y = yn[M:min(len(yn), M + P.shape[0])]

            ymx = float(np.max(np.abs(y)))
            w = 1.0 + pa * (np.abs(y) / (ymx + 1e-12))

            Pl.append(P)
            Yl.append(y)
            Wl.append(w)

        if not Pl:
            raise ValueError("No valid segments are long enough for N-block training.")

        PA = np.vstack(Pl)
        YA = np.concatenate(Yl)
        WA = np.concatenate(Wl)

        mdl = Ridge(alpha=ra, fit_intercept=False).fit(
            PA,
            YA,
            sample_weight=WA,
        )

        logging.info("N-block trained: %d coefficients, lambda=%.4f", len(mdl.coef_), ra)

        return mdl.coef_, vm, vs, ym, ys

    @staticmethod
    def apply(Xs, coeffs, vm, vs, M=None, ym=0.0, ys=1.0):
        if M is None:
            M = CONFIG["N_BLOCK_MEMORY"] - 1

        res = []

        for s in Xs:
            vn = (s - vm) / vs

            if len(vn) <= M:
                res.append(np.zeros_like(s))
                continue

            P = VolterraNBlock.expand(vn, M)
            f = np.dot(P, coeffs)
            out = np.concatenate([np.zeros(M), f]) * ys + ym
            res.append(out[:len(s)])

        return res


# ============================================================
# 4. Signal-processing helpers
# ============================================================
class SP:
    @staticmethod
    def peak_to_trough_amplitude(s, template=None, heartbeat=False):
        ref = template if template is not None else s
        distance = 110 if heartbeat else 45

        peaks, _ = signal.find_peaks(
            ref,
            distance=distance,
            prominence=np.std(ref) * 0.4,
        )

        if len(peaks) < 2:
            return float(np.std(s) * 2.5)

        amps = []

        for p in peaks:
            ss = max(0, p - 15)
            se = min(len(s), p + 15)
            local_peak = ss + int(np.argmax(s[ss:se]))
            trough_end = min(len(s), local_peak + 90)
            local_trough = local_peak + int(np.argmin(s[local_peak:trough_end]))
            amps.append(s[local_peak] - s[local_trough])

        return float(np.median(amps))

    @staticmethod
    def align(on_bed, under_bed, inverse_filter):
        reconstructed = irfft(rfft(under_bed) * inverse_filter)
        xc = signal.correlate(on_bed, reconstructed, mode="same")
        idx = int(np.argmax(np.abs(xc)))
        shift = signal.correlation_lags(
            len(on_bed),
            len(reconstructed),
            mode="same",
        )[idx]

        sign = np.sign(xc[idx])
        if sign == 0:
            sign = 1.0

        return np.roll(reconstructed * sign, shift)


def make_bandpass():
    # fs = 200 Hz -> Nyquist = 100 Hz
    return signal.butter(4, [0.8 / 100, 10.0 / 100], "bandpass")


def preprocess_segment(x, b, a):
    return signal.filtfilt(b, a, signal.detrend(x))


def safe_corr(x, y):
    if len(x) < 2 or len(y) < 2:
        return np.nan
    if np.std(x) < 1e-12 or np.std(y) < 1e-12:
        return np.nan
    try:
        return float(pearsonr(x, y)[0])
    except Exception:
        return np.nan


# ============================================================
# 5. Data loading
# ============================================================
def load_segments(path):
    x = np.load(path)
    x = np.asarray(x, dtype=float).reshape(-1, CONFIG["SAMPLES_PER_SEGMENT"])

    if x.shape[0] == 0:
        raise ValueError(f"No segments found in {path}")

    return x


# ============================================================
# 6. Estimate calibration transfer function H_est
# ============================================================
def estimate_h1_transfer(cal_under, cal_on, freqs):
    logging.info("Step 1/5: estimating H1 transfer function from calibration data")

    b, a = make_bandpass()
    Pxx, Pxy = [], []

    for i in range(len(cal_under)):
        on = preprocess_segment(cal_on[i], b, a)
        under = preprocess_segment(cal_under[i], b, a)

        _, pxx = signal.welch(
            on,
            fs=CONFIG["SAMPLING_RATE"],
            nperseg=500,
        )
        _, pxy = signal.csd(
            on,
            under,
            fs=CONFIG["SAMPLING_RATE"],
            nperseg=500,
        )

        Pxx.append(pxx)
        Pxy.append(pxy)

    Pxx_m = np.mean(Pxx, axis=0)
    Pxy_m = np.mean(Pxy, axis=0)

    H_w = np.nan_to_num(Pxy_m / (Pxx_m + 1e-30), nan=0.0)
    fw = np.linspace(0, CONFIG["SAMPLING_RATE"] / 2, len(H_w))

    H_est = np.interp(freqs, fw, H_w)

    # Keep exactly the smoothing idea used in the original code.
    H_est = signal.savgol_filter(H_est, 21, 3, axis=0)

    return H_est


# ============================================================
# 7. Physics-guided regularized inverse
# ============================================================
def build_inverse_filters(freqs, H_est):
    logging.info("Step 2/5: building physics-guided regularized inverse filters")

    h_sp = PhysicsEngine.get_transfer_function(
        freqs,
        CONFIG["D_BASE"],
        CONFIG["SPEAKER_WEIGHT_KG"],
        False,
    )

    h_hu = PhysicsEngine.get_transfer_function(
        freqs,
        CONFIG["D_BASE"],
        CONFIG["HUMAN_WEIGHT_KG"],
        True,
    )

    lam = CONFIG["TIKHONOV_LAMBDA"]
    band = (freqs >= 0.8) & (freqs <= 10.0)

    scale_sp = (
        np.median(np.abs(H_est[band]))
        / (np.median(np.abs(h_sp[band])) + 1e-30)
    )

    scale_hu = (
        np.median(np.abs(H_est[band]))
        / (np.median(np.abs(h_hu[band])) + 1e-30)
    )

    hsp_scaled = h_sp * scale_sp
    hhu_scaled = h_hu * scale_hu

    Hrs = (
        np.abs(hsp_scaled) ** 2 * H_est + lam * hsp_scaled
    ) / (
        np.abs(hsp_scaled) ** 2 + lam
    )

    Hrh = (
        np.abs(hhu_scaled) ** 2 * H_est + lam * hhu_scaled
    ) / (
        np.abs(hhu_scaled) ** 2 + lam
    )

    H_inv_sp = np.conj(Hrs) / (np.abs(Hrs) ** 2 + lam)
    H_inv_hu = np.conj(Hrh) / (np.abs(Hrh) ** 2 + lam)

    logging.info("Physics scale (speaker): %.3f", scale_sp)
    logging.info("Physics scale (human):   %.3f", scale_hu)

    return H_inv_sp, H_inv_hu


# ============================================================
# 8. Train N-block on calibration data
# ============================================================
def train_nblock(cal_under, cal_on, H_inv_sp):
    logging.info("Step 3/5: training nonlinear N-block on calibration data")

    b, a = make_bandpass()
    crop = CONFIG["CROP_SIZE"]

    X_train, Y_train = [], []

    for i in range(len(cal_under)):
        under = preprocess_segment(cal_under[i], b, a)
        on = preprocess_segment(cal_on[i], b, a)

        inverse_output = SP.align(on, under, H_inv_sp)

        X_train.append(inverse_output[crop:-crop])
        Y_train.append(on[crop:-crop])

    return VolterraNBlock.train(X_train, Y_train)


# ============================================================
# 9. Test-set reconstruction and evaluation
# ============================================================
def evaluate_test_set(test_under, test_on, H_inv_hu, nb):
    logging.info("Step 4/5: reconstructing and evaluating the held-out test set")

    b, a = make_bandpass()
    crop = CONFIG["CROP_SIZE"]
    nc, vm, vs, ym, ys = nb

    rows = []
    under_aligned_all = []
    reconstructed_all = []
    reference_all = []

    for i in range(len(test_under)):
        under = preprocess_segment(test_under[i], b, a)
        on = preprocess_segment(test_on[i], b, a)

        # For visualization: bandpass-only under-bed signal aligned to the reference.
        under_aligned = SP.align(
            on,
            under,
            np.ones_like(H_inv_hu),
        )[crop:-crop]

        # Main method: human physics-guided inverse + trained N-block.
        inverse_output = SP.align(
            on,
            under,
            H_inv_hu,
        )[crop:-crop]

        reference = on[crop:-crop]

        reconstructed = VolterraNBlock.apply(
            [inverse_output],
            nc,
            vm,
            vs,
            ym=ym,
            ys=ys,
        )[0][:len(reference)]

        corr = safe_corr(reference, reconstructed)

        amp_ref = SP.peak_to_trough_amplitude(
            reference,
            heartbeat=True,
        )
        amp_rec = SP.peak_to_trough_amplitude(
            reconstructed,
            template=reference,
            heartbeat=True,
        )

        ptae = abs(amp_ref - amp_rec) / (abs(amp_ref) + 1e-12) * 100.0

        rows.append({
            "sample_index_0_based": i,
            "sample_index_1_based": i + 1,
            "corr": corr,
            "ptae_percent": float(ptae),
        })

        under_aligned_all.append(under_aligned)
        reconstructed_all.append(reconstructed)
        reference_all.append(reference)

    corrs = np.asarray([r["corr"] for r in rows], dtype=float)
    ptaes = np.asarray([r["ptae_percent"] for r in rows], dtype=float)

    summary = {
        "n_test_segments": len(rows),
        "corr_mean": float(np.nanmean(corrs)),
        "corr_std": float(np.nanstd(corrs)),
        "ptae_mean": float(np.nanmean(ptaes)),
        "ptae_std": float(np.nanstd(ptaes)),
    }

    return rows, summary, under_aligned_all, reconstructed_all, reference_all


# ============================================================
# 10. Display selected test samples
# ============================================================
def plot_test_waveforms(
    rows,
    under_aligned_all,
    reconstructed_all,
    reference_all,
):
    """
    Display a user-selected inclusive range of test samples.

    CONFIG uses 1-based sample numbers:
        VISUALIZE_START = 1
        VISUALIZE_END   = 5
    displays samples #1 through #5.

    Nothing is saved to disk.
    """
    start_1 = int(CONFIG["VISUALIZE_START"])
    end_1 = int(CONFIG["VISUALIZE_END"])
    n_total = len(rows)

    if start_1 < 1:
        raise ValueError('CONFIG["VISUALIZE_START"] must be >= 1.')
    if end_1 < start_1:
        raise ValueError(
            'CONFIG["VISUALIZE_END"] must be >= CONFIG["VISUALIZE_START"].'
        )
    if end_1 > n_total:
        raise ValueError(
            f'Requested samples #{start_1}-#{end_1}, but the test set only '
            f'contains {n_total} samples.'
        )

    # Convert the user-friendly 1-based range to Python indices.
    indices = list(range(start_1 - 1, end_1))
    n_show = len(indices)

    # One subplot per test sample.
    fig_height = max(3.2, 2.6 * n_show)
    fig, axes = plt.subplots(
        n_show,
        1,
        figsize=(11, fig_height),
        squeeze=False,
    )
    axes = axes[:, 0]

    fs = CONFIG["SAMPLING_RATE"]

    for ax, idx in zip(axes, indices):
        under = np.asarray(under_aligned_all[idx])
        reconstructed = np.asarray(reconstructed_all[idx])
        reference = np.asarray(reference_all[idx])
        t = np.arange(len(reference)) / fs

        ax.plot(t, under, lw=0.9, label="Under-bed signal")
        ax.plot(t, reconstructed, lw=1.1, label="Reconstructed signal")
        ax.plot(t, reference, lw=1.1, label="On-bed reference")

        ax.set_ylabel("Amplitude [a.u.]")
        ax.set_title(
            f"Test sample #{idx + 1} | "
            f"Corr={rows[idx]['corr']:.4f}, "
            f"PTAE={rows[idx]['ptae_percent']:.2f}%"
        )
        ax.grid(True, linestyle=":", alpha=0.4)
        ax.margins(x=0)

    axes[-1].set_xlabel("Time [s]")
    axes[0].legend(frameon=False, ncol=3, loc="upper right")

    fig.suptitle(
        f"Held-out test samples #{start_1}–#{end_1}",
        fontsize=13,
        y=0.995,
    )
    fig.tight_layout(rect=[0, 0, 1, 0.985])

    # Show interactively; do not save any figure files.
    plt.show()


# ============================================================
# 13. Main pipeline
# ============================================================
def main():
    # --------------------------------------------------------
    # A. Input files
    # --------------------------------------------------------
    paths = {
        # Calibration / fitting data
        "train_under": r"D:\UGA\CoreDemo-master\CoreDemo-master\influxexample\filtered_raw_signal_after_2026-03-16T153949_2026-03-16T160155.npy",
        "train_on": r"D:\UGA\CoreDemo-master\CoreDemo-master\influxexample\filtered_raw_signal_before_2026-03-16T153949_2026-03-16T160155.npy",

        # Held-out heartbeat test data
        "test_under": r"D:\UGA\CoreDemo-master\CoreDemo-master\influxexample\raw_signal_after_2026-03-16T160423_2026-03-16T160923.npy",
        "test_on": r"D:\UGA\CoreDemo-master\CoreDemo-master\influxexample\raw_signal_before_2026-03-16T160423_2026-03-16T160923.npy",
    }

    # --------------------------------------------------------
    # B. Load data
    # --------------------------------------------------------
    logging.info("Loading calibration and test data")

    try:
        train_under = load_segments(paths["train_under"])
        train_on = load_segments(paths["train_on"])
        test_under = load_segments(paths["test_under"])
        test_on = load_segments(paths["test_on"])
    except Exception as exc:
        print(f"File Error: {exc}")
        return

    if train_under.shape != train_on.shape:
        raise ValueError(
            f"Calibration pair shape mismatch: {train_under.shape} vs {train_on.shape}"
        )

    if test_under.shape != test_on.shape:
        raise ValueError(
            f"Test pair shape mismatch: {test_under.shape} vs {test_on.shape}"
        )

    logging.info(
        "Loaded calibration=%d segments, test=%d segments",
        train_under.shape[0],
        test_under.shape[0],
    )

    freqs = rfftfreq(
        CONFIG["SAMPLES_PER_SEGMENT"],
        1.0 / CONFIG["SAMPLING_RATE"],
    )

    # --------------------------------------------------------
    # C. Main reconstruction pipeline
    # --------------------------------------------------------
    H_est = estimate_h1_transfer(
        train_under,
        train_on,
        freqs,
    )

    H_inv_sp, H_inv_hu = build_inverse_filters(
        freqs,
        H_est,
    )

    nb = train_nblock(
        train_under,
        train_on,
        H_inv_sp,
    )

    rows, summary, under_all, reconstructed_all, reference_all = evaluate_test_set(
        test_under,
        test_on,
        H_inv_hu,
        nb,
    )

    # --------------------------------------------------------
    # D. Final output
    # --------------------------------------------------------
    print("\n" + "=" * 72)
    print("FINAL TEST RESULTS")
    print("=" * 72)
    print(f"Test segments : {summary['n_test_segments']}")
    print(
        f"Correlation   : {summary['corr_mean']:.4f} "
        f"+/- {summary['corr_std']:.4f}"
    )
    print(
        f"PTAE          : {summary['ptae_mean']:.2f}% "
        f"+/- {summary['ptae_std']:.2f}%"
    )
    print(
        f"Waveforms shown : samples "
        f"#{CONFIG['VISUALIZE_START']}-#{CONFIG['VISUALIZE_END']}"
    )
    print("=" * 72)

    # Final step: display the selected test samples interactively.
    # Nothing is saved to disk.
    plot_test_waveforms(
        rows,
        under_all,
        reconstructed_all,
        reference_all,
    )


if __name__ == "__main__":
    main()
